package client.ui;

/**
 * Listener interface for game panel events
 */
public interface GamePanelListener {
    /**
     * Called when user submits a guess
     * @param guess The guessed number string
     */
    void onGuessSubmitted(String guess);

    /**
     * Called when user sends a chat message
     * @param message The chat message
     */
    void onChatSent(String message);

    /**
     * Called when user requests to disconnect/exit
     */
    void onDisconnectRequested();
}
